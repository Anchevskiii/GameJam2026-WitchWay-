# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Godot scripts and text resource files
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cfg text eol=lf
*.import text eol=lf
*.shader text eol=lf
*.gdshader text eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets (prevent line ending corruption)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
