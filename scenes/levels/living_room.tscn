[node name="LivingRoom" instance=ExtResource("1_base")]
room_title = "The Living Room"
objective = "BOO the cardboard ghost from BEHIND (SPACE), or hide (E) and jump out. Try scaring the kid too."
layout = "######################
##3#####4###1######2##
#Q.W+LB+.H+L.VS++vCR+#
